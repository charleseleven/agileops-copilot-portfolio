# Copie para .env (fora do controle de versão) e preencha só o que for usar.
# A CLI procura o .env a partir do diretório atual, subindo até a raiz — variáveis já definidas no ambiente prevalecem.

# ===== IA (necessária só para documentos em texto livre / --prompt) =====
# Qualquer API compatível com OpenAI chat/completions. Padrão: Groq (mesma do Flow Diagnostics).
LLM_API_KEY=
# LLM_API_URL=https://api.groq.com/openai/v1/
# LLM_MODEL=openai/gpt-oss-120b
# LLM_MAX_TOKENS=16384

# ===== Azure DevOps (--target azure) =====
# Mesmo padrão do mcp-tooling/: PAT por organização ou o PAT padrão da extensão azure-devops da Azure CLI.
# Escopo mínimo do PAT: Work Items (Read & Write).
AZURE_DEVOPS_EXT_PAT=
# AZURE_DEVOPS_PAT_<ORGANIZACAO_EM_MAIUSCULO>=
AZURE_DEVOPS_DEFAULT_ORG=sua-organizacao
AZURE_DEVOPS_DEFAULT_PROJECT=Seu Projeto

# ===== Jira Cloud (--target jira) =====
# JIRA_BASE_URL=https://sua-empresa.atlassian.net
# JIRA_EMAIL=voce@empresa.com
# JIRA_API_TOKEN=
# JIRA_PROJECT_KEY=LOJA
# Campo de story points varia por site (Configurações → Campos personalizados). Padrão Cloud:
# JIRA_STORY_POINTS_FIELD=customfield_10016

# ===== Trello (--target trello) =====
# Chave e token em https://trello.com/power-ups/admin (ou trello.com/app-key)
# TRELLO_API_KEY=
# TRELLO_TOKEN=
# TRELLO_BOARD_ID=
