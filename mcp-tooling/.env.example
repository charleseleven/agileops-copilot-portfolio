# PAT da organização padrão (mesma variável usada pela extensão azure-devops da Azure CLI)
AZURE_DEVOPS_EXT_PAT=
AZURE_DEVOPS_DEFAULT_ORG=sua-organizacao
AZURE_DEVOPS_DEFAULT_PROJECT=Seu Projeto
# Projeto dos repositórios/pipelines, quando diferente do projeto de Boards
# AZURE_DEVOPS_DEFAULT_REPOS_PROJECT=Seu Projeto - Repositorios

# PAT por organização adicional (fora da AZURE_DEVOPS_DEFAULT_ORG acima).
# Padrão da chave: AZURE_DEVOPS_PAT_<ORGANIZACAO_EM_MAIUSCULO>
# Escopo mínimo para o fluxo de GMUD: Work Items (leitura), Code (leitura/escrita), Build (leitura).
# AZURE_DEVOPS_PAT_OUTRAORG=

# App Services (lidos via Azure CLI; requer az login). Nunca versionar o valor real.
# AZURE_SUBSCRIPTION_ID=

# Fluxo de GMUD (tools gmud_*): pasta com gmud.config.json e gmuds/ (padrão: ../gmud-automation)
# GMUD_WORKDIR=
# Comando da CLI instalada como dotnet tool (padrão: dotnet run no projeto GmudAutomation.Cli)
# GMUD_CLI=gmud
