{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "LlmSettings": {
    "ApiUrl": "https://api.groq.com/openai/v1/",
    "ApiKey": "",
    "DefaultModel": "openai/gpt-oss-120b",
    "TimeoutSeconds": 30,
    "MaxRetries": 3
  },
  "AzureDevOpsSettings": {
    "ApiUrl": "https://dev.azure.com/",
    "Organization": "",
    "Project": "",
    "PersonalAccessToken": "",
    "ApiVersion": "7.1",
    "TimeoutSeconds": 30,
    "OrganizationTokens": {}
  },
  "FlowAnalyticsSettings": {
    "BaselineWindowDays": 90,
    "StartStatuses": [ "In Progress", "Doing", "Code Review" ],
    "DoneStatuses": [ "Done", "Closed", "Resolved" ],
    "DefaultCriticalThresholdDays": 3.0,
    "StdDevMultiplier": 1.5,
    "MinimumSampleSizeForBaseline": 5
  },
  "SprintRiskSettings": {
    "WarningUtilizationThreshold": 0.85,
    "CriticalUtilizationThreshold": 1.0,
    "PaceToleranceRatio": 0.9,
    "CriticalSlipWorkingDays": 2,
    "HourTrackedWorkItemTypes": [ "Task", "Bug" ],
    "DoneStates": [ "Done", "Closed", "Resolved" ],
    "ExcludedStates": [ "Removed" ],
    "TimeZoneId": "America/Sao_Paulo",
    "SystemPromptTemplate": ""
  }
}
